# Daily API-Football download for Dugout (see scripts/daily-fetch.ts).
# Install: npm run daily:install   Logs: journalctl --user -u dugout-daily-fetch
[Unit]
Description=Dugout daily league download (API-Football Free quota)
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
Environment=PATH=@PATH@
ExecStart=@NPM@ run --silent daily:fetch
TimeoutStartSec=1h
